# =============================================================================
# BIOXIC Backend — Node.js + Express + Prisma + PostgreSQL
# Variabile de mediu (înlocuiește cu valorile reale pentru mediul tău)
# Nu commita fișierul .env cu credențiale reale!
# =============================================================================

# Conexiune PostgreSQL
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:REPLACE_ME@localhost:5432/bioxic?schema=public"

# Server
PORT=5000
NODE_ENV=development

# CORS (originele frontend-ului, separate prin virgulă)
CORS_ORIGINS=http://localhost:3000,https://your-domain.example

# JWT
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=24h

# Admin seed (contul super-admin creat la pornire)
ADMIN_EMAIL=admin@bioxic.ro
ADMIN_PASSWORD=REPLACE_ME

# Persistent local file storage
BIOXIC_STORAGE_DIR=./uploads
SITE_URL=https://your-domain.example

# Google OAuth (fan login)
GOOGLE_CLIENT_ID=523589663667-....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-....

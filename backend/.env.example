MONGO_URL=mongodb://localhost:27017
DB_NAME=bioxic
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@bioxic.ro
ADMIN_PASSWORD=replace-with-unique-password-16-to-72-bytes
SITE_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example,http://localhost:3000
BIOXIC_STORAGE_DIR=./uploads

# Configure a Google OAuth client whose redirect URI is:
# https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional outbound email via your SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_FROM_NAME=BIOXIC
